/node_modules
# Comitido a propósito (no ignorado): el deploy en cPanel no tiene Node.js
# disponible, así que los assets se compilan en local con `npm run build`
# y se suben ya listos junto con el resto del código. Acordarse de correr
# `npm run build` y comitear el resultado antes de cada deploy.
/public/fonts-manifest.dev.json
/public/hot
/public/storage
# Referencias de diseño (mockups) usadas para comparar el frontend — no son
# assets de la aplicación, no se comitean.
/public/images/mockups
/storage/*.key
/storage/pail
/vendor
